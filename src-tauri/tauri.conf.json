{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recode",
  "version": "0.1.2",
  "identifier": "com.adityapainuli.recode",
  "build": {
    "beforeDevCommand": "node scripts/fetch-ffmpeg.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-ffmpeg.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recode",
        "width": 560,
        "height": 640,
        "resizable": true,
        "minWidth": 480,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/recode-ffmpeg", "binaries/recode-ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
